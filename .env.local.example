# Шаблон локального окружения запусков: скопировать в .env.local и вписать
# свои значения. .env.local в git не живёт; скрипты interview/ подхватывают
# его при старте, переменные из профиля шелла имеют приоритет. Секретов в
# значениях быть не должно — только пути к файлам с ними (файлы вне репо).

# адрес сервера ollama (дефолт http://localhost:11434)
OLLAMA_BASE_URL=http://ollama-host:11434

# путь к env-файлу с ключами GigaChat/Яндекс/DeepSeek
# (GIGACHAT_AUTHORIZATION_KEY, YANDEXFM_API_KEY, DEEPSEEK_API_KEY)
MODELS_RU_ENV=~/path/to/cloud-keys.env

# ID каталога Яндекса для gpt://<folder>/yandexgpt/latest
YANDEXFM_FOLDER_ID=

# путь к файлу с ключом OpenRouter
OPENROUTER_KEY_FILE=~/.config/llm-keys/openrouter.key

# путь к файлу с адресом прокси (или OPENROUTER_PROXY=host:port напрямую)
OPENROUTER_PROXY_FILE=~/.config/llm-keys/openrouter-proxy
