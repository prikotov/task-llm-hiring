+        $this->cost = $cost6;
+        $this->appliedPriceValidFrom = $priceValidFrom;
+    }
+
+    /** Пересчёт после ретро-коррекции цены. */
+    public function setCost(string $cost6): void
+    {
+        $this->cost = $cost6;
+    }
+}
