+                FROM usage_events e
+                LEFT JOIN event_ratings r ON r.event_id = e.id
+                WHERE r.id IS NULL
+                ORDER BY e.id
+            SQL
+        );
+
+        if ($ids === []) {
+            return [];
+        }
+
+        return $this->findBy(['id' => $ids]);
