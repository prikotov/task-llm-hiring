+class UsageEvent
+{
+    #[ORM\Id]
+    #[ORM\GeneratedValue(strategy: 'IDENTITY')]
+    #[ORM\Column(type: 'bigint')]
+    private int $id = 0;
+
+    #[ORM\Column(type: 'string', length: 255)]
+    private string $provider = '';
+
+    #[ORM\Column(type: 'string', length: 255)]
+    private string $providerRequestId = '';
