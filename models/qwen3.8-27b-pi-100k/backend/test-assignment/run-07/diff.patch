+ * Тарификация ещё не рассчитанных событий (app:billing:rate).
+ *
+ * Для каждого pending-события:
+ *  1) выбор цены — строка модели с максимальным valid_from <= ts;
+ *  2) точный расчёт по схеме (per_1m_tokens | per_1m_tokens_unified);
+ *  3) оф-пик провайдера (если UTC-момент в окне);
+ *  4) единственное округление HALF_UP до 6 знаков.
+ *
+ * Событие без подходящей цены остаётся pending (unrated) — каждый
+ * следующий запуск rate повторяет попытку (цены могли «догрузиться»).
+ */
+final class BillingService
+{
+    public function __construct(
+        private readonly EntityManagerInterface $em,
+        private readonly BillingComputer $computer,
+    ) {
+    }
+
+    public function rate(): RateRun
+    {
+        return $this->em->wrapInTransaction(function (): RateRun {
+            $snapshot = CatalogSnapshot::load($this->em);
+
+            /** @var UsageEvent[] $pending */
+            $pending = $this->em->getRepository(UsageEvent::class)->findBy(
+                ['status' => UsageEvent::STATUS_PENDING],
+                ['id' => 'ASC'],
+            );
+
+            $rated = 0;
+            $unrated = [];
+
+            foreach ($pending as $event) {
+                $priceRow = $snapshot->findPriceRow($event->getProvider(), $event->getModel(), $event->getTs());
+                if ($priceRow === null) {
+                    $unrated[] = $event;
+                    continue;
+                }
+
+                $cost = $this->computer
+                    ->calculate(
+                        $event->getTokensInput(),
+                        $event->getTokensOutput(),
+                        $event->getTokensCacheRead(),
+                        $event->getTokensCacheWrite(),
+                        PriceUnit::from($priceRow->getUnit()),
+                        $priceRow->getRates(),
+                        $snapshot->offPeakFor($event->getProvider()),
+                        $event->getTs(),
+                    )
+                    ->roundHalfUp();
+
+                $event->markRated($cost, $priceRow);
+                $rated++;
+            }
+
+            $this->em->flush();
+
+            $leftUnrated = (int) $this->em->createQuery(
+                'SELECT COUNT(e.id) FROM ' . UsageEvent::class . ' e WHERE e.status = :status'
+            )
+                ->setParameter('status', UsageEvent::STATUS_PENDING)
+                ->getSingleScalarResult();
+
+            return new RateRun($rated, $leftUnrated, $unrated);
+        });
+    }
+}
diff -ruN -x var -x .env -x __pycache__ -x .git /home/dp/MyProjects/Models/test-assignment/backend/billing/skeleton/src/Service/CatalogSnapshot.php /tmp/billing-pi-7hrspi92/repo/src/Service/CatalogSnapshot.php
--- /home/dp/MyProjects/Models/test-assignment/backend/billing/skeleton/src/Service/CatalogSnapshot.php	1970-01-01 07:00:00.000000000 +0700
+++ /tmp/billing-pi-7hrspi92/repo/src/Service/CatalogSnapshot.php	2026-10-27 13:29:30.242368024 +0700
@@ -0,0 +1,90 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Service;
+
+use App\Domain\OffPeakWindow;
+use App\Entity\Model;
+use App\Entity\PriceRow;
+use App\Entity\Provider;
+use Doctrine\ORM\EntityManagerInterface;
+
+/**
+ * Мгновенное снимок-справочника на время одного прогона rate/reprice:
+ * провайдеры (с оф-пиком), модели и строки цен, отсортированные по
+ * valid_from по убыванию для быстрого выбора цены.
+ */
+final class CatalogSnapshot
+{
+    /**
+     * @param array<string, Provider> $providersByCode code => provider
+     * @param array<string, list<PriceRow>> $priceRowsByModelKey «providerCode\0modelCode» => строки цен (valid_from DESC)
+     */
+    public function __construct(
+        private readonly array $providersByCode,
+        private readonly array $priceRowsByModelKey,
+    ) {
+    }
+
+    public static function load(EntityManagerInterface $em): self
+    {
+        $providersByCode = [];
+        foreach ($em->getRepository(Provider::class)->findAll() as $provider) {
+            $providersByCode[$provider->getCode()] = $provider;
+        }
+
+        $rows = $em->createQuery(
+            'SELECT pr FROM ' . PriceRow::class . ' pr'
+        )->getResult();
+
+        $priceRowsByModelKey = [];
+        foreach ($rows as $row) {
+            $key = $row->getModel()->getProvider()->getCode() . "\0" . $row->getModel()->getCode();
+            $priceRowsByModelKey[$key][] = $row;
+        }
+
+        foreach ($priceRowsByModelKey as $key => $list) {
+            usort($list, static fn (PriceRow $a, PriceRow $b): int => $b->getValidFrom() <=> $a->getValidFrom());
+            $priceRowsByModelKey[$key] = $list;
+        }
+
+        return new self($providersByCode, $priceRowsByModelKey);
+    }
+
+    /**
+     * Строка цены для события: максимальный valid_from <= ts;
+     * null — если провайдер/модель из события неизвестны справочнику
+     * либо ни одна строка не действует в момент события.
+     */
+    public function findPriceRow(string $providerCode, string $modelCode, \DateTimeInterface $ts): ?PriceRow
+    {
+        foreach ($this->priceRowsByModelKey[$providerCode . "\0" . $modelCode] ?? [] as $row) {
+            if ($row->getValidFrom() <= $ts) {
+                return $row;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Оф-пик провайдера события (null — скидки нет или провайдер неизвестен).
+     */
+    public function offPeakFor(string $providerCode): ?OffPeakWindow
+    {
+        $provider = $this->providersByCode[$providerCode] ?? null;
+        if ($provider === null
+            || $provider->getOffPeakWindowStart() === null
+            || $provider->getOffPeakWindowEnd() === null
+            || $provider->getOffPeakMultiplier() === null) {
+            return null;
+        }
+
+        return new OffPeakWindow(
+            $provider->getOffPeakWindowStart(),
+            $provider->getOffPeakWindowEnd(),
+            $provider->getOffPeakMultiplier(),
+        );
+    }
+}
