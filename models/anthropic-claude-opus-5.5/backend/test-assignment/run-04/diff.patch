+    {
+        return $this->rates;
+    }
+
+    public function unit(): string
+    {
+        return $this->unit;
+    }
+
+    public function currency(): string
+    {
+        return $this->currency;
+    }
+
+    public function model(): ModelEntity
+    {
+        return $this->model;
+    }
+}
