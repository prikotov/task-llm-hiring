+                \App\Billing\Domain\Shared\Time::formatIso($event->ts()),
+            ));
+        }
+
+        $output->writeln(sprintf('RATED=%d UNRATED=%d', $result['rated'], count($result['unrated'])));
+
+        return Command::SUCCESS;
+    }
+}
