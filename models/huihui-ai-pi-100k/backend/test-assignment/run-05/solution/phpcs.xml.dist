<?xml version="1.0"?>
<ruleset name="App">
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName.Missing"/>
    </rule>
    <file>src</file>
    <file>tests</file>
</ruleset>
