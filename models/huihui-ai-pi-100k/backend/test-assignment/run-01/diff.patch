+    public function testRepriceUpdatesCostsAndWritesCorrections(): void
+    {
+        $this->runCommand('app:prices:import', ['file' => self::PRICES]);
+        $this->runCommand('app:usage:import', ['file' => self::USAGE]);
+        $this->runCommand('app:billing:rate');
