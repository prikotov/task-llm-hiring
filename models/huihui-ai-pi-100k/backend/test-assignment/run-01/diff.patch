+        $refTester = $this->runCommand('app:prices:import', ['file' => $refFile]);
+        self::assertSame(0, $refTester->getStatusCode(), $refTester->getDisplay());
+
+        $usageFile = tempnam(sys_get_temp_dir(), 'usage-');
+        $noPriceLine = json_encode([
