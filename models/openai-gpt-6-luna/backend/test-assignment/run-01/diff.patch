+<?php
+declare(strict_types=1);
+namespace App\Console;
+use Doctrine\DBAL\Connection;use Symfony\Component\Console\Attribute\AsCommand;use Symfony\Component\Console\Command\Command;use Symfony\Component\Console\Input\InputInterface;use Symfony\Component\Console\Input\InputOption;use Symfony\Component\Console\Output\OutputInterface;
+#[AsCommand(name:'app:billing:report')]
+final class ReportCommand extends Command{public function __construct(private Connection $db){parent::__construct();}protected function configure():void{$this->addOption('from',null,InputOption::VALUE_REQUIRED);$this->addOption('to',null,InputOption::VALUE_REQUIRED);}protected function execute(InputInterface $i,OutputInterface $o):int{$sql="SELECT e.user_id, e.provider_code||'/'||e.model_code model,SUM(tokens_input) ti,SUM(tokens_output) too,SUM(tokens_cache_read) tcr,SUM(tokens_cache_write) tcw,SUM(cost)::text cost FROM usage_events e WHERE rated=TRUE";$params=[];if($i->getOption('from')){$sql.=' AND event_ts>=?';$params[]=$i->getOption('from');}if($i->getOption('to')){$sql.=' AND event_ts<?';$params[]=$i->getOption('to');}$sql.=' GROUP BY e.user_id,model ORDER BY e.user_id,model';$rows=$this->db->fetchAllAssociative($sql,$params);$o->writeln('user,model,tokens_input,tokens_output,tokens_cache_read,tokens_cache_write,cost_usd');$tot=array_fill(0,5,'0');foreach($rows as $r){$vals=[(string)$r['ti'],(string)$r['too'],(string)$r['tcr'],(string)$r['tcw'],bcadd((string)$r['cost'],'0',6)];$o->writeln(implode(',',[$r['user_id'],$r['model'],...$vals]));for($x=0;$x<4;$x++)$tot[$x]=bcadd($tot[$x],$vals[$x],0);$tot[4]=bcadd($tot[4],$vals[4],6);}$o->writeln('TOTAL,,'.implode(',',array_slice($tot,0,4)).','.($tot[4]??'0.000000'));return 0;}}
