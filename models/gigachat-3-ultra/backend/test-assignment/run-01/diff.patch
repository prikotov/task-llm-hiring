+        if (isset($typeContext?->templates[$identifier])) {
+            return Type::template($identifier, $typeContext->templates[$identifier]);
+        }
+
+        if (isset($typeContext?->typeAliases[$identifier])) {
+            return $typeContext->typeAliases[$identifier];
+        }
