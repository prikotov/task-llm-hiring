+    {
+        return $this->name;
+    }
+
+    /**
+     * @return T
+     */
+    public function getBound(): Type
+    {
+        return $this->bound;
+    }
+
+    public function getWrappedType(): Type
+    {
+        return $this->bound;
+    }
+
+    /**
+     * @param-immediately-invoked-callable $specification
+     */
+    public function wrappedTypeIsSatisfiedBy(callable $specification): bool
+    {
