+            if (class_exists($className) || interface_exists($className)) {
+                self::$classExistCache[$className] = true;
+            } else {
+                try {
+                    new \ReflectionClass($className);
+                    self::$classExistCache[$className] = true;
+                } catch (\Throwable) {
+                }
+            }
+        }
