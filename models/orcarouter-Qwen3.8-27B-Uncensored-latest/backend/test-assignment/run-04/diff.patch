+    public function testBadTimestampRejected(): void
+    {
+        $this->expectException(ImportException::class);
+
+        $this->parser->parseLine(\json_encode([
+            'provider' => 'p1',
+            'provider_request_id' => 'r1',
+            'model' => 'm1',
+            'user' => 'u1',
+            'ts' => '15.09.2026 11:00',
+            'tokens_input' => 1,
+            'tokens_output' => 0,
+            'tokens_cache_read' => 0,
+            'tokens_cache_write' => 0,
+        ]), 7);
+    }
