+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain\Billing\Entity;
+
+use Doctrine\ORM\Mapping as ORM;
+
+/**
+ * Модель провайдера. Натуральный ключ — (provider, code).
+ */
