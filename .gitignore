# локальные env-значения (адреса серверов, пути к ключам) — в git не живут
.env.local
.zcodeignore
.zcode/

# внутренняя бухгалтерия трат OpenRouter
reports/openrouter-spend.csv

# vendor тестового задания (ставится composer install)
interview/vendor/

# vendor скелета billing-тестового: в git не живёт, ставится один раз
# composer install (README test-assignment/backend/billing) — прогоны копируют с ним
interview/test-assignment/backend/billing/skeleton/vendor/

# мусор локальных запусков
.deptrac.cache
:memory
__pycache__/
*.pyc

# конфиг Obsidian
.obsidian/

# результаты прогонов тестового задания (этап 2): пока не в git —
# раздувают PR #14; возвращаем перед финальным отчётом этапа
models/*/backend/test-assignment/
