{
    "name": "task/llm-billing-assignment",
    "description": "Тестовое задание: учёт расходов на LLM-токены",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.3",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "php": ">=8.4",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/var-exporter": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
